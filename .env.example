# ── Credentials ───────────────────────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored — never commit it.
SF_USERNAME=you@example.com
SF_PASSWORD=your-password
SF_SECURITY_TOKEN=your-security-token

# Connected App / External Client App consumer key + secret.
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# JWT bearer flow — the right answer for SSO-federated or MFA-gated orgs.
# It is the only headless flow that issues a *web*-scoped token, which is
# what lets the browser skip the login page entirely (ui_login: frontdoor).
# Setup guide: docs/AUTHENTICATION.md
# SF_JWT_KEY_FILE=.certs/sfauto.key
# SF_JWT_USERNAME=you@example.com

# Keep records a test created instead of deleting them at teardown.
# SFAUTO_KEEP_RECORDS=1

# ── Org selection ─────────────────────────────────────────────────────
# Which profiles/<name>.yml to use. See: sfauto profiles
SFAUTO_PROFILE=default

# Any profile value can be overridden here; env always wins.
# SF_LOGIN_URL=https://test.salesforce.com
# SF_TIMEZONE=America/Los_Angeles
# SF_API_NAMESPACE=vlocity_cmt
# SFAUTO_RECORD_PREFIX=SFAUTO

# ── Run behaviour ─────────────────────────────────────────────────────
BROWSER_HEADLESS=false
MAX_PARALLEL=4
DASHBOARD_PORT=8091
# SCREENCAST_DISABLED=1     # turn off live browser-in-browser streaming
# SFAUTO_CAPTURE=1          # record raw request/response traffic

# ── Branding (optional) ───────────────────────────────────────────────
# SFAUTO_BRAND_NAME=Spread Unconditional Love
# SFAUTO_BRAND_TAGLINE=Salesforce Test Automation
