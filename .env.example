# ── Credentials ───────────────────────────────────────────────────────
# Copy to .env and fill in. .env is git-ignored — never commit it.
SF_USERNAME=you@example.com
SF_PASSWORD=your-password
SF_SECURITY_TOKEN=your-security-token

# Connected App (only needed for OAuth / some API flows)
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# ── Org selection ─────────────────────────────────────────────────────
# Which profiles/<name>.yml to use. See: sfauto profiles
SFAUTO_PROFILE=default

# Any profile value can be overridden here; env always wins.
# SF_LOGIN_URL=https://test.salesforce.com
# SF_TIMEZONE=America/Los_Angeles
# SF_API_NAMESPACE=vlocity_cmt
# SFAUTO_RECORD_PREFIX=SFAUTO

# ── Run behaviour ─────────────────────────────────────────────────────
BROWSER_HEADLESS=false
MAX_PARALLEL=4
DASHBOARD_PORT=8091
# SCREENCAST_DISABLED=1     # turn off live browser-in-browser streaming
# SFAUTO_CAPTURE=1          # record raw request/response traffic

# ── Branding (optional) ───────────────────────────────────────────────
# SFAUTO_BRAND_NAME=Spread Unconditional Love
# SFAUTO_BRAND_TAGLINE=Salesforce Test Automation
